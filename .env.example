# Skopiuj do .env i uzupełnij: cp .env.example .env
# Klucz API OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Asystent głosowy — opcjonalne nadpisania modeli OpenRouter (domyślne poniżej)
# ASSISTANT_MODEL=openai/gpt-6-luna
# ASSISTANT_REASONING=none
# TRANSCRIBE_MODEL=microsoft/mai-transcribe-2
# SPEECH_MODEL=microsoft/mai-voice-2.1
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Adres API backendu widziany z serwera Next.js (dev: http://localhost:8080)
API_URL=http://localhost:8080
